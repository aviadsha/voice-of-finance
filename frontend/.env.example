# Backend API base URL as seen from the Next.js server (no trailing slash).
# Local dev: http://localhost:8000 · docker compose: http://backend:8000 · production: your Fly.io/Railway URL
API_URL=http://localhost:8000

# Public URL of this frontend (required by NextAuth in production).
NEXTAUTH_URL=http://localhost:3000

# Secret used to encrypt session cookies. Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
