# ---------------------------------------------------------------------------
# Voice of Finance - backend configuration
# Copy to `.env` and fill in the values. Never commit real secrets.
# ---------------------------------------------------------------------------

# development | staging | production
ENVIRONMENT=development
DEBUG=false
# Comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# --- Database --------------------------------------------------------------
# Option A: individual settings (used by docker-compose / local Postgres)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=voice_of_finance

# Option B: a full connection string (takes precedence). Works with Supabase,
# Railway, Fly Postgres, Neon... `postgres://` URLs are converted to asyncpg.
# Supabase: Project Settings -> Database -> Connection string -> "Session pooler".
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Set to true when using a PgBouncer *transaction* pooler (Supabase port 6543).
DATABASE_PGBOUNCER=false

# --- Auth ------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- AI providers ----------------------------------------------------------
# Whisper transcription
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1
# Claude insight extraction + article generation
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MAX_TOKENS=8000

# --- Extraction ------------------------------------------------------------
AUDIO_WORKDIR=/tmp/voice-of-finance-audio
WHISPER_MAX_CHUNK_MB=24
WHISPER_CHUNK_SECONDS=600
MAX_VIDEO_DURATION_SECONDS=10800

# --- Community -------------------------------------------------------------
ANALYST_VERIFICATION_THRESHOLD=100

# --- Billing ---------------------------------------------------------------
# MVP mock checkout: lets users self-upgrade to premium without paying.
# When unset it is enabled in development and DISABLED when ENVIRONMENT=production.
# BILLING_MOCK_ENABLED=true

# --- Container entrypoint --------------------------------------------------
RUN_MIGRATIONS=true
SEED_DEMO_DATA=false
