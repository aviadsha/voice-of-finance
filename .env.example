# Root environment file read by `docker compose` (copy to `.env`).
# Service-specific settings for running outside Docker live in backend/.env.example and frontend/.env.example.

# AI providers (optional for the demo data; required to process real YouTube interviews)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Secrets - generate with: openssl rand -base64 32
JWT_SECRET_KEY=change-me
NEXTAUTH_SECRET=change-me

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=voice_of_finance

# Insert demo interview + articles on startup
SEED_DEMO_DATA=true
